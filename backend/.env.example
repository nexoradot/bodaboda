# Copy to your deployment environment; never commit real secrets.
BODAPAY_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development may use SQLite. Production must use PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Set explicit frontend/API origins for deployed environments.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true

# M-Pesa secrets belong in backend deployment secrets only; do not add them here or to Git.
# Daraja integration remains intentionally disabled until credentials and callback verification are implemented.
